{
  "name": "lebonmedoc",
  "version": "0.1.0",
  "description": "LeBonMédoc - réservation de médicaments en pharmacies partenaires (atelier DDD)",
  "type": "module",
  "main": "src/serveur.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/serveur.js",
    "dev": "node --watch --env-file-if-exists=.env src/serveur.js",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "db:logs": "docker compose logs -f db",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
