{
  "info": {
    "name": "LeBonMédoc API",
    "description": "Collection de requêtes pour l'API LeBonMédoc. Sélectionner l'environnement « LeBonMédoc - Local ».",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Santé",
      "item": [
        {
          "name": "Vérification de santé (API + base de données)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', () => pm.response.to.have.status(200));",
                  "pm.test('Base de données joignable', () => {",
                  "  pm.expect(pm.response.json().baseDeDonnees.statut).to.eql('disponible');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{urlBase}}/api/health",
              "host": ["{{urlBase}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "Pharmacies",
      "item": [
        {
          "name": "Lister les pharmacies",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', () => pm.response.to.have.status(200));",
                  "pm.test('Retourne un tableau', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{urlBase}}/api/pharmacies",
              "host": ["{{urlBase}}"],
              "path": ["api", "pharmacies"]
            }
          }
        },
        {
          "name": "Créer une pharmacie",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 201', () => pm.response.to.have.status(201));",
                  "pm.environment.set('pharmacieId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Pharmacie du Peyrou\",\n  \"adresse\": \"5 rue Foch\",\n  \"ville\": \"Montpellier\",\n  \"codePostal\": \"34000\",\n  \"telephone\": \"0400000003\",\n  \"horairesOuverture\": { \"lun\": [\"09:00\", \"19:00\"] }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{urlBase}}/api/pharmacies",
              "host": ["{{urlBase}}"],
              "path": ["api", "pharmacies"]
            }
          }
        },
        {
          "name": "Obtenir une pharmacie",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{urlBase}}/api/pharmacies/{{pharmacieId}}",
              "host": ["{{urlBase}}"],
              "path": ["api", "pharmacies", "{{pharmacieId}}"]
            }
          }
        }
      ]
    }
  ]
}
